FROM archlinux:base-devel

# pacman's download sandbox needs seccomp/user-namespace syscalls that QEMU
# emulation (e.g. linux/amd64 on an Apple Silicon host) doesn't support.
RUN echo "DisableSandbox" >> /etc/pacman.conf

RUN pacman -Syu --noconfirm \
    python \
    python-pip \
    git \
    nmap \
    && pacman -Scc --noconfirm

WORKDIR /app
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY tests /app/tests

RUN pip install --break-system-packages -e ".[dev]"

CMD ["bash"]
