# 登録済みの許可対象。
# 明示的に許可された対象のみをここに追加してください。
# `pownforge target add` 経由で追加・保存します。手動編集はスキーマに注意してください。
#
# 実際に使う際は、このファイルを config/targets.yaml としてコピーしてください
# (config/targets.yaml は .gitignore 済みで、リポジトリにはコミットされません)。
#
# 例:
# targets:
#   lab-web:
#     kind: host
#     address: 127.0.0.1
#     allowed_plugins:
#     - network
#     notes: null
#
# 練習用の意図的に脆弱なイメージは `pownforge lab add` で登録するのが
# 推奨です(下記はその結果としてこのファイルに書き込まれる内容の例。
# 手動で書く必要はありません。docs/handbook.md §7参照)。
#
#   pownforge lab add metasploitable2 --image tleemcjr/metasploitable2 \
#     --kind host --allowed-plugins network,vulncheck
#   pownforge lab add lab-web --image bkimminich/juice-shop \
#     --kind url --port 3000 --allowed-plugins web,network
targets: {}
