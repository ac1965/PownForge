#!/usr/bin/env bash
# Stub CLI used only by emacs/tests/pownforge-test.el: mimics the exact
# textual/JSON shapes the real `pownforge` binary produces for the
# subcommands pownforge.el shells out to, so the Elisp tests can run
# without a Python environment or real scan targets.
set -euo pipefail

if [ "$1" = "fail" ]; then
  echo "boom" >&2
  exit 1
fi

case "$1 $2" in
  "target list")
    printf 'lab-web\turl\thttp://lab-web:3000\tplugins=web, nuclei\ttype=web\tenv=local-lab\n'
    printf 'kind-lab\thost\tkind-pownforge-lab\tplugins=kubernetes\ttype=kubernetes\tenv=local-lab\n'
    ;;
  "plugin list")
    printf 'network\tv1\tok\tnmap-based network recon\n'
    printf 'nuclei\tv1\tmissing tool (nuclei)\ttemplate-based vulnerability detection\n'
    ;;
  "result list")
    printf 'run001\t2026-09-22T10:00:00+00:00\tlab-web\tnuclei\n'
    ;;
  "result show")
    cat <<'JSON'
{
  "run_id": "run001",
  "target": "lab-web",
  "plugin": "nuclei",
  "created_at": "2026-09-22T10:00:00+00:00",
  "evidence": {"returncode": 0, "tool_version": "Nuclei Engine Version: v3.11.1"},
  "output": {},
  "findings": [
    {"finding_id": "f1", "title": "Exposed admin panel", "severity": "medium", "detail": "found at /admin", "source": "tool", "status": "needs-review"},
    {"finding_id": "f2", "title": "Critical RCE template match", "severity": "critical", "detail": "matched CVE-0000", "source": "tool", "status": "needs-review"}
  ],
  "analysis": null
}
JSON
    ;;
  "result review")
    echo "finding '$4' on run '$3' -> $5"
    ;;
  "report generate")
    echo "wrote /tmp/fake-pownforge-report-$3.md"
    ;;
  "walkthrough generate")
    echo "wrote /tmp/fake-pownforge-walkthrough.md"
    ;;
  "audit list")
    printf 'v1\t2026-09-22T09:00:00+00:00\tunregistered-host\tnetwork\ttarget '"'"'unregistered-host'"'"' is not registered\n'
    ;;
  "scan live-ok")
    echo "line one"
    sleep 0.05
    echo "line two"
    sleep 0.05
    echo "run abc123 completed (exit=0)"
    ;;
  "scan live-noid")
    # Exits 0 but never prints a "run <id> completed" line (e.g. a plugin
    # that errored out internally without ScanRunner ever persisting a
    # RunRecord), exercising the sentinel's no-run-id branch.
    echo "something went sideways, no run id this time"
    ;;
  "playbook list")
    printf 'web-baseline\t3 steps\tnetwork -> web -> nuclei\n'
    ;;
  "playbook show")
    cat <<'TXT'
web-baseline: network -> web -> nuclei
  1. network (ports=80,443)
  2. web (wordlist=config/wordlists/common.txt)
  3. nuclei (tags=exposure,misconfig,tech)
TXT
    ;;
  "playbook run")
    echo "[1/2] running network..."
    sleep 0.05
    echo "[1/2] network: run aaaaaaaaaaaa completed (exit=0)"
    sleep 0.05
    echo "[2/2] running web..."
    sleep 0.05
    echo "[2/2] web: run bbbbbbbbbbbb completed (exit=0)"
    echo "playbook 'web-baseline' finished: 2/2 steps succeeded (0 skipped, 0 failed)"
    ;;
  "attack-session list")
    printf 'op-1\t1 stages\tinitial foothold via Shellshock\n'
    ;;
  "attack-session show")
    cat <<TXT
op-1: initial foothold via Shellshock
engagement: eng-1
  1. run001: lab-web / nuclei [exploit] — initial recon
TXT
    ;;
  "attack-session create")
    echo "created attack session '$3'"
    ;;
  "attack-session add-stage")
    echo "added stage 1 ($4) to attack session '$3'"
    ;;
  "attack-session report")
    echo "wrote /tmp/fake-pownforge-attack-session-$3.md"
    ;;
  "primitive list")
    printf 'http.oob-interaction\t[oob-interaction]\tmax_level=validation\tOOB HTTP interaction check\n'
    printf '    --option path (required): Absolute path containing {callback}\n'
    printf 'jndi.oob-lookup-probe\t[oob-interaction]\tmax_level=validation\tLog4Shell-class exposure indicator\n'
    ;;
  "primitive runs")
    printf 'p001\thttp.oob-interaction\tlab-web\tlevel=validation\t2026-09-22T11:00:00+00:00\n'
    ;;
  "primitive run")
    echo "primitive run p001 completed (level_reached=validation)"
    echo "preconditions: P1.controllable_input=met, P2.url_target=met"
    echo "evidence: observations=1 findings=1 claims=1"
    ;;
  "result import")
    echo "run imp001 recorded (target=$4, plugin=manual)"
    ;;
  "result tag")
    echo "run $3 cves: CVE-2021-44228"
    ;;
  *)
    echo "fake-pownforge: unhandled args: $*" >&2
    exit 2
    ;;
esac
